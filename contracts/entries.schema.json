{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloodchild8906.github.io/shattered-crucible-owlbear/contracts/entries.schema.json",
  "title": "Shattered Crucible Homebrew Category File",
  "type": "object",
  "required": [
    "contract",
    "schemaVersion",
    "packId",
    "category",
    "entries"
  ],
  "properties": {
    "contract": {
      "const": "sc.homebrew.entries"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\."
    },
    "packId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "category": {
      "type": "string",
      "enum": [
        "atlas",
        "backgrounds",
        "characters",
        "classes",
        "encounters",
        "feats",
        "guilds",
        "homebrew",
        "items",
        "journal",
        "locations",
        "materials",
        "monsters",
        "npcs",
        "recipes",
        "shops",
        "species",
        "spells",
        "subclasses",
        "reputation",
        "handouts",
        "music",
        "sfx"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "rarity": {
            "type": "string"
          },
          "price": {
            "type": "object",
            "properties": {
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "currency": {
                "enum": [
                  "cp",
                  "sp",
                  "ep",
                  "gp",
                  "pp"
                ]
              }
            }
          },
          "mechanics": {
            "type": "object"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
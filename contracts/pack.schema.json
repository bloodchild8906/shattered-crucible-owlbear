{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloodchild8906.github.io/shattered-crucible-owlbear/contracts/pack.schema.json",
  "type": "object",
  "required": [
    "contract",
    "schemaVersion",
    "id",
    "version",
    "name",
    "publisher",
    "data"
  ],
  "properties": {
    "contract": {
      "const": "sc.homebrew.pack"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "publisher": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "data": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "license": {
      "type": "string"
    },
    "mediaBase": {
      "type": "string"
    },
    "minSuiteVersion": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}